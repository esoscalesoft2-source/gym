# ---------------------------------------------------------------------------
# Firebase — Console → Project settings → General → Your apps → Web app
# These are public by design; firebase/firestore.rules is the security boundary.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef

# ---------------------------------------------------------------------------
# Server only. Console → Project settings → Service accounts → Generate new
# private key. Paste the JSON on one line, or base64-encode it (easier on
# Windows). NEVER prefix this with NEXT_PUBLIC_ — it bypasses every rule.
#   node -e "console.log(require('fs').readFileSync(process.argv[1]).toString('base64'))" key.json
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cloud Storage needs the Blaze plan. Leave this false until the bucket exists —
# uploading to a missing bucket hangs the submit button instead of failing.
NEXT_PUBLIC_UPLOADS_ENABLED=false

# The single gym this site hires for (Phase 1).
# The document id of gyms/{id} — see firebase/seed.md step 5.
NEXT_PUBLIC_GYM_ID=

# Shown on the landing page / form header
NEXT_PUBLIC_GYM_NAME=Your Gym Name
NEXT_PUBLIC_GYM_CITY=Chennai
